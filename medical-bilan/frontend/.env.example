# ============================================================
# Medical Bilan — Frontend environment variables
# Copy to `.env` (not committed). All vars MUST be prefixed VITE_
# to be exposed to the browser.
# ============================================================

# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# App display name (shown in PWA manifest title)
VITE_APP_NAME=Clinique
