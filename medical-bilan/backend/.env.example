# ============================================================
# Medical Bilan — Backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to git.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Public URL of THIS backend, reachable from the internet.
# Twilio fetches the TwiML and audio from this host when placing calls.
# - In dev: use ngrok (`ngrok http 5000`) and put the https URL here.
# - In prod: your real https domain (e.g. https://api.clinique.dz).
APP_PUBLIC_URL=https://your-ngrok-or-domain.example

# ============================================================
# DATABASE — Supabase Postgres
# ============================================================
# From Supabase: Settings → Database → Connection string (URI, "Transaction" pooler).
# Replace [PASSWORD] with the DB password you set when creating the project.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# ============================================================
# SUPABASE — Storage (PDFs)
# ============================================================
# From Supabase: Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...     # ⚠️ Backend ONLY. Never expose.
SUPABASE_BUCKET=bilans

# ============================================================
# JWT
# ============================================================
# Use a long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ============================================================
# TWILIO — Voice + SMS
# ============================================================
# From https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX                       # Your Twilio phone number (must support voice + SMS for AR/FR)

# ============================================================
# RESEND — Email
# ============================================================
# Sign up at https://resend.com (free: 3,000 emails/month, 100/day)
# Verify a sending domain (or use the default `onboarding@resend.dev` for testing).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Clinique <noreply@clinique.dz>

# ============================================================
# CLINIC INFO (used in notifications)
# ============================================================
CLINIC_NAME=Clinique Dr. Example
CLINIC_PHONE=+213XXXXXXXXX
